{
  "name": "@lipecode/barcode-scanner-payloadcms",
  "version": "0.1.0",
  "description": "Barcode scanning for Payload CMS 3 admin fields, with camera, USB keyboard-wedge and manual entry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LipeMachado/barcode-scanner-payloadcms.git"
  },
  "homepage": "https://github.com/LipeMachado/barcode-scanner-payloadcms#readme",
  "bugs": {
    "url": "https://github.com/LipeMachado/barcode-scanner-payloadcms/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./scanner": {
      "types": "./dist/scanner/index.d.ts",
      "import": "./dist/scanner/index.js",
      "default": "./dist/scanner/index.js"
    },
    "./styles.css": "./dist/client/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "barcode",
    "barcode-scanner",
    "camera"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build",
    "pack:check": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.91.0",
    "payload": "^3.91.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@lipecode/barcode-scanner-payloadcms": "0.1.0",
    "@zxing/browser": "^0.2.1"
  },
  "devDependencies": {
    "@payloadcms/ui": "3.91.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^28.0.0",
    "payload": "3.91.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
